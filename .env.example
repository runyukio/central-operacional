# Ambiente
APP_ENV="local"
USE_LOCAL_DB="true"
ALLOW_DEMO_LOGIN="false"
ALLOW_DEMO_DATA="false"
NEXT_PUBLIC_ENABLE_DEMO_USERS="false"
ALLOW_DEMO_SEED="false"
INITIAL_ADMIN_EMAIL="admin@central.com"
INITIAL_ADMIN_PASSWORD="Central@123"
INITIAL_COLLABORATOR_PASSWORD="Central@123"

# Prisma / Postgres local via Docker
DATABASE_URL="postgresql://central:central123@localhost:5432/central_operacional?schema=public"
DIRECT_URL="postgresql://central:central123@localhost:5432/central_operacional?schema=public"

# Supabase Auth / Storage são opcionais no modo local.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Sessão NextAuth/Auth.js compatibility layer
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="central-local-secret-change-later"

# Captura direta de horas em tempo real
REALTIME_HOURS_AGENT_TOKEN=""

# Legado: usado apenas se o servidor concentrador local ainda estiver ativo
REALTIME_HOURS_IMPORT_TOKEN=""

REALTIME_HOURS_MAX_RECORDS_PER_IMPORT="1000"
REALTIME_HOURS_STALE_MINUTES="15"
REALTIME_HOURS_IDLE_SECONDS="300"

# Report CEC via Data Export agendado do Freshdesk
CEC_FRESHDESK_API_KEY=""
CEC_FRESHDESK_REPORT_URL="https://kuaishousupport.freshdesk.com/reports/schedule/download_file.json?uuid=UUID_DO_NOVO_EXPORT"

# Omie - criação automática de Contas a Pagar após aprovação do invoice
OMIE_APP_KEY=""
OMIE_APP_SECRET=""
OMIE_ACCOUNT_PAYABLE_CATEGORY_CODE=""
# Opcional quando o fornecedor já possui conta corrente padrão no Omie
OMIE_CHECKING_ACCOUNT_ID=""
# Vencimento contado a partir da aprovação. Padrão: no mesmo dia.
OMIE_PAYMENT_DUE_DAYS="0"
OMIE_API_TIMEOUT_MS="15000"

# Produção futura com Supabase:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
