  userAgent     String?
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
}

model ErrorLog {
  id         String    @id @default(cuid())
  userId     String?
  code       String?
  message    String
  stack      String?
  route      String?
  action     String?
  severity   String    @default("ERROR")
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([createdAt, severity])
  @@index([userId])
}

model StoredFile {
