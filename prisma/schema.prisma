model AttendanceRecord {
  id                      String              @id @default(cuid())
  employeeId              String
  scheduleId              String?
  date                    DateTime
  shiftId                 String?
  status                  AttendanceStatus
  absenceReason           String?
  reasonCategory          String?
  supervisorJustification String?
  hasEvidence             Boolean             @default(false)
  evidenceUrl             String?
  isJustified             Boolean             @default(false)
  impactsAbs              Boolean             @default(false)
  impactsCoverage         Boolean             @default(false)
  registeredById          String?
  justifiedById           String?
  registeredAt            DateTime            @default(now())
  justifiedAt             DateTime?
  employee                EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule                Schedule?           @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  shift                   Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  registeredBy            User?               @relation("AttendanceRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  justifiedBy             User?               @relation("AttendanceJustifiedBy", fields: [justifiedById], references: [id], onDelete: SetNull)
  histories               AttendanceHistory[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([employeeId, date, shiftId])
  @@index([date, status])
  @@index([date, isJustified])
  @@index([employeeId, date])
  @@index([employeeId])
  @@index([scheduleId])
  @@index([scheduleId, isJustified])
  @@index([scheduleId, updatedAt])
  @@index([isJustified])
  @@index([registeredById])
  @@index([justifiedById])
