  createdAt          DateTime          @default(now())
}

model WorkHourImportBatch {
  id          String               @id @default(cuid())
  fileName    String
  uploadedById String
  totalRows   Int
  validRows   Int
  errorRows   Int
  warningRows Int                @default(0)
  createdRows Int                @default(0)
  updatedRows Int                @default(0)
  status      WorkHourImportStatus @default(IMPORTED)
  uploadedBy  User                 @relation("WorkHourImportUploadedBy", fields: [uploadedById], references: [id])
  records     WorkHourRecord[]
  createdAt   DateTime             @default(now())

  @@index([uploadedById, createdAt])
  @@index([status, createdAt])
}

model WorkHourRecord {
  id                String                 @id @default(cuid())
  employeeId        String
  scheduleId        String?
  wbLogin           String
  date              DateTime
  plannedStart      String?
  plannedEnd        String?
  plannedHours      Float?
  actualStart       String?
  actualEnd         String?
  breakMinutes      Int                    @default(0)
  actualHours       Float
  adjustedStart     String?
  adjustedEnd       String?
  adjustedBreakMinutes Int?
  adjustedHours     Float?
  effectiveStart    String?
  effectiveEnd      String?
  effectiveBreakMinutes Int                @default(0)
  effectiveHours    Float
  differenceMinutes Int?
  status            WorkHourRecordStatus   @default(IMPORTED)
  source            String?
  observation       String?
  importBatchId     String?
  employee          EmployeeProfile        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule          Schedule?              @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  importBatch       WorkHourImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  adjustments       WorkHourAdjustmentRequest[]
  histories         WorkHourHistory[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([scheduleId])
  @@index([wbLogin])
  @@index([date])
  @@index([date, employeeId])
  @@index([date, status])
  @@index([status])
  @@index([importBatchId])
}

model WorkHourAdjustmentRequest {
  id                   String                   @id @default(cuid())
  workHourRecordId     String
  employeeId           String
  requestedById        String
  approvedById         String?
  rejectedById         String?
  status               WorkHourAdjustmentStatus @default(ABERTO)
  currentActualStart   String?
  currentActualEnd     String?
  currentBreakMinutes  Int?
  currentActualHours   Float
  requestedActualStart String?
  requestedActualEnd   String?
  requestedBreakMinutes Int?
  requestedActualHours Float
  reason               String
  justification        String
  rejectionReason      String?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  record               WorkHourRecord           @relation(fields: [workHourRecordId], references: [id], onDelete: Cascade)
  employee             EmployeeProfile          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy          User                     @relation("WorkHourAdjustmentRequestedBy", fields: [requestedById], references: [id])
  approvedBy           User?                    @relation("WorkHourAdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy           User?                    @relation("WorkHourAdjustmentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([workHourRecordId])
  @@index([employeeId])
  @@index([requestedById])
  @@index([status, createdAt])
}

model WorkHourHistory {
  id               String          @id @default(cuid())
  workHourRecordId String
  changedById      String?
  action           String
  previousValue    Json?
  newValue         Json?
  reason           String?
  record           WorkHourRecord  @relation(fields: [workHourRecordId], references: [id], onDelete: Cascade)
