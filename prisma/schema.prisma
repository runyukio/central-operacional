generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum ScheduleStatus {
  ESCALADO
  PRESENTE
  AUSENTE
  FALTA
  ATRASO
  SAIDA_ANTECIPADA
  AFASTADO
  FOLGA
  FERIAS
  TREINAMENTO
  NESTING
  TROCA_APROVADA
  VENDA_FOLGA_APROVADA
  FOLGA_APROVADA
  SEM_ESCALA
  ERRO_ESCALA
  FERIADO
  CONFLITO
  DESCOBERTO
  DESLIGADO
}

enum RequestStatus {
  ABERTO
  EM_ANALISE
  AGUARDANDO_APROVACAO
  APROVADO
  RECUSADO
  AJUSTE_SOLICITADO
  CONCLUIDO
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum AnnouncementStatus {
  RASCUNHO
  AGENDADO
  PUBLICADO
  ARQUIVADO
}

enum FeedbackClassification {
  POSITIVO
  ATENCAO
  CRITICO
}

enum EquipmentStatus {
  DISPONIVEL
  ENTREGUE
  FUNCIONANDO
  EM_ATENCAO
  EM_MANUTENCAO
  INOPERANTE
  DEVOLVIDO
  PERDIDO
  BLOQUEADO
  SUBSTITUIDO
}

enum EquipmentImpact {
  BAIXO
  MEDIO
  ALTO
}

enum TicketStatus {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO
  RESOLVIDO
  CANCELADO
}

enum ClimateQuestionType {
  ESCALA_1_5
  TEXTO_LIVRE
  MULTIPLA_ESCOLHA
  SIM_NAO
  NPS_0_10
}

enum AnonymousFeedbackStatus {
  RECEBIDO
  EM_ANALISE
  PLANO_DE_ACAO
  CONCLUIDO
  ARQUIVADO
}

enum TokenTransactionType {
  GANHO
  RESGATE
  AJUSTE
  EXPIRACAO
}

enum RedemptionStatus {
  SOLICITADO
  APROVADO
  RECUSADO
  ENTREGUE
  CANCELADO
}

enum AuditAction {
  CRIACAO
  EDICAO
  EXCLUSAO
  APROVACAO
  RECUSA
  UPLOAD
  IMPORTACAO
  ALTERACAO_ESCALA
  ALTERACAO_PERMISSAO
  ALTERACAO_EQUIPAMENTO
  CONFIRMACAO_LEITURA
  RESGATE_TOKEN
  LOGIN
}

enum CoverageRisk {
  EXCELENTE
  ADEQUADO
  ATENCAO
  CRITICO
}

enum ChatRoomType {
  INDIVIDUAL
  TIME
  LOB
  AREA
}

enum EmployeeRegistrationStatus {
  RASCUNHO
  ENVIADO
  PENDENTE_APROVACAO
  AJUSTE_SOLICITADO
  APROVADO
  RECUSADO
  ATIVO
  INATIVO
}

enum ShiftReportImportance {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum GeneralMood {
  MUITO_BOM
  BOM
  NEUTRO
  RUIM
  CRITICO
}

enum FollowUpStatus {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  FALTA
  ATRASO
  SAIDA_ANTECIPADA
  AFASTADO
  FERIAS
  TREINAMENTO
  FOLGA
  TROCA_APROVADA
  SEM_ESCALA
  ERRO_ESCALA
}

enum WorkHourRecordStatus {
  IMPORTED
  OK
  DIVERGENT
  NO_SCHEDULE
  MISSING_WORK_HOURS
  ADJUSTMENT_REQUESTED
  ADJUSTMENT_APPROVED
  ADJUSTMENT_REJECTED
  MANUALLY_CORRECTED
}

enum WorkHourAdjustmentStatus {
  ABERTO
  EM_ANALISE
  APROVADO
  RECUSADO
  CANCELADO
}

enum WorkHourImportStatus {
  IMPORTED
  PARTIAL
  FAILED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  users       UserPermission[]
  createdAt   DateTime         @default(now())
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  name                    String
  passwordHash            String
  mustChangePassword      Boolean                 @default(false)
  passwordChangedAt       DateTime?
  temporaryPassword       Boolean                 @default(false)
  lastPasswordResetAt     DateTime?
  passwordResetById       String?
  avatarUrl               String?
  status                  UserStatus              @default(ACTIVE)
  roleId                  String
  role                    Role                    @relation(fields: [roleId], references: [id])
  permissions             UserPermission[]
  employeeProfile         EmployeeProfile?
  requestedRequests       Request[]               @relation("RequestRequester")
  assignedRequests        Request[]               @relation("RequestAssignee")
  requestComments         RequestComment[]
  requestHistory          RequestHistory[]
  approvalSteps           ApprovalStep[]
  authoredAnnouncements   Announcement[]
  announcementReads       AnnouncementRead[]
  notifications           Notification[]
  authoredFeedbacks       QualityFeedback[]       @relation("FeedbackAuthor")
  qualityMaterials        QualityMaterial[]
  climateAnswers          ClimateAnswer[]
  rewardRedemptions       RewardRedemption[]
  chatParticipants        ChatParticipant[]
  chatMessages            ChatMessage[]
  auditLogs               AuditLog[]
  scheduleImports         ScheduleImport[]
  scheduleChangeHistories ScheduleChangeHistory[]
  equipmentHistories      EquipmentHistory[]
  equipmentTickets        EquipmentTicket[]
  registeredAttendances   AttendanceRecord[]      @relation("AttendanceRegisteredBy")
  justifiedAttendances    AttendanceRecord[]      @relation("AttendanceJustifiedBy")
  attendanceHistories     AttendanceHistory[]     @relation("AttendanceHistoryChangedBy")
  workHourImports         WorkHourImportBatch[]   @relation("WorkHourImportUploadedBy")
  requestedWorkHourAdjustments WorkHourAdjustmentRequest[] @relation("WorkHourAdjustmentRequestedBy")
  approvedWorkHourAdjustments  WorkHourAdjustmentRequest[] @relation("WorkHourAdjustmentApprovedBy")
  rejectedWorkHourAdjustments  WorkHourAdjustmentRequest[] @relation("WorkHourAdjustmentRejectedBy")
  workHourHistories       WorkHourHistory[]       @relation("WorkHourHistoryChangedBy")
  monthlyAdvanceUpdates   MonthlyAdvanceRecord[]  @relation("MonthlyAdvanceUpdatedBy")
  createdStaffCoverages   StaffCoverage[]         @relation("StaffCoverageCreatedBy")
  updatedStaffCoverages   StaffCoverage[]         @relation("StaffCoverageUpdatedBy")
  moodRecords             EmployeeMoodRecord[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
}

model Lob {
  id             String            @id @default(cuid())
  name           String            @unique
  description    String?
  teams          Team[]
  employees      EmployeeProfile[]
  staffCoverages StaffCoverage[]
  createdAt      DateTime          @default(now())
}

model Team {
  id           String            @id @default(cuid())
  name         String
  lobId        String
  supervisorId String?
  lob          Lob               @relation(fields: [lobId], references: [id])
  supervisor   EmployeeProfile?  @relation("TeamSupervisor", fields: [supervisorId], references: [id])
  employees    EmployeeProfile[] @relation("TeamEmployees")
  createdAt    DateTime          @default(now())

  @@unique([name, lobId])
}

model Shift {
  id                String             @id @default(cuid())
  name              String             @unique
  startsAt          String
  endsAt            String
  color             String
  employees         EmployeeProfile[]
  schedules         Schedule[]
  attendanceRecords AttendanceRecord[]
  coverages         StaffCoverage[]
  createdAt         DateTime           @default(now())
}

model EmployeeProfile {
  id                 String                  @id @default(cuid())
  userId             String?                 @unique
  user               User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  wbLogin            String                  @unique
  fullName           String
  socialName         String?
  primaryPhone       String?
  city               String?
  stateUf            String?
  preferredSchedule  String?
  roleTitle          String
  admissionDate      DateTime
  trainingStartDate  DateTime?
  terminationDate    DateTime?
  terminationType    String?
  terminationReason  String?
  ethnicity          String?
  sexualOrientation  String?
  isPcd              String?
  pcdDisabilityType  String?
  pcdDisabilityOther String?
  firstJob           String?
  hasTelemarketingExperience String?
  telemarketingWhere String?
  nestingStartDate   DateTime?
  goLiveDate         DateTime?
  workStartTime      String?
  workEndTime        String?
  scheduleType       String
  contractType       String?
  siteOperation      String?
  internalNotes      String?
  skill              String?
  wave               String?
  operationalStatus  String                  @default("Online")
  lobId              String
  teamId             String
  supervisorId       String?
  managerId          String?
  shiftId            String
  lob                Lob                     @relation(fields: [lobId], references: [id])
  team               Team                    @relation("TeamEmployees", fields: [teamId], references: [id])
  supervisor         EmployeeProfile?        @relation("SupervisorTree", fields: [supervisorId], references: [id])
  supervisees        EmployeeProfile[]       @relation("SupervisorTree")
  manager            EmployeeProfile?        @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports      EmployeeProfile[]       @relation("EmployeeHierarchy")
  supervisedTeams    Team[]                  @relation("TeamSupervisor")
  shift              Shift                   @relation(fields: [shiftId], references: [id])
  schedules          Schedule[]
  attendanceRecords  AttendanceRecord[]
  workHourRecords    WorkHourRecord[]
  workHourAdjustments WorkHourAdjustmentRequest[]
  monthlyAdvanceRecords MonthlyAdvanceRecord[]
  scheduleChanges    ScheduleChangeHistory[]
  requests           Request[]
  performanceMetrics PerformanceMetric[]
  qualityFeedbacks   QualityFeedback[]       @relation("FeedbackEmployee")
  equipments         Equipment[]
  equipmentTickets   EquipmentTicket[]
  tokenBalance       TokenBalance?
  tokenTransactions  TokenTransaction[]
  rewardRedemptions  RewardRedemption[]
  moodRecords        EmployeeMoodRecord[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?

  @@index([lobId])
  @@index([teamId])
  @@index([supervisorId])
  @@index([managerId])
  @@index([shiftId])
  @@index([roleTitle])
  @@index([skill])
  @@index([wave])
  @@index([operationalStatus])
  @@index([deletedAt])
}

model Schedule {
  id                String             @id @default(cuid())
  employeeId        String
  shiftId           String?
  lobId             String?
  supervisorId      String?
  date              DateTime
  startsAt          String?
  endsAt            String?
  status            ScheduleStatus     @default(ESCALADO)
  observation       String?
  source            String             @default("seed")
  employee          EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift             Shift?             @relation(fields: [shiftId], references: [id])
  attendanceRecords AttendanceRecord[]
  workHourRecords    WorkHourRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@unique([employeeId, date])
  @@index([date, status])
  @@index([date, lobId])
  @@index([date, supervisorId])
  @@index([date, shiftId])
  @@index([date, deletedAt])
  @@index([employeeId])
  @@index([lobId])
  @@index([supervisorId])
  @@index([shiftId])
  @@index([status])
  @@index([deletedAt])
}

model ScheduleImport {
  id           String              @id @default(cuid())
  fileName     String
  importedById String
  status       String
  totalRows    Int
  validRows    Int
  errorRows    Int
  warnings     Json?
  importedBy   User                @relation(fields: [importedById], references: [id])
  rows         ScheduleImportRow[]
  createdAt    DateTime            @default(now())
}

model ScheduleImportRow {
  id          String         @id @default(cuid())
  importId    String
  rowNumber   Int
  wbLogin     String?
  name        String?
  lob         String?
  supervisor  String?
  date        DateTime?
  shift       String?
  startsAt    String?
  endsAt      String?
  status      String?
  observation String?
  validation  Json?
  import      ScheduleImport @relation(fields: [importId], references: [id], onDelete: Cascade)
}

model ScheduleChangeHistory {
  id            String          @id @default(cuid())
  scheduleId    String?
  employeeId    String
  changedById   String
  date          DateTime
  before        Json
  after         Json
  previousValue Json?
  newValue      Json?
  reason        String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changedBy     User            @relation(fields: [changedById], references: [id])
  createdAt     DateTime        @default(now())
}

model RequestType {
  id               String         @id @default(cuid())
  name             String         @unique
  area             String
  slaHours         Int            @default(24)
  requiresApproval Boolean        @default(true)
  requests         Request[]
  approvalFlows    ApprovalFlow[]
}

model Request {
  id            String             @id @default(cuid())
  code          String             @unique
  title         String
  description   String
  requesterId   String
  employeeId    String?
  typeId        String
  assigneeId    String?
  assignedArea  String
  priority      Priority           @default(MEDIA)
  status        RequestStatus      @default(ABERTO)
  payload       Json?
  requester     User               @relation("RequestRequester", fields: [requesterId], references: [id])
  employee      EmployeeProfile?   @relation(fields: [employeeId], references: [id])
  type          RequestType        @relation(fields: [typeId], references: [id])
  assignee      User?              @relation("RequestAssignee", fields: [assigneeId], references: [id])
  comments      RequestComment[]
  history       RequestHistory[]
  approvalFlows ApprovalFlow[]
  redemptions   RewardRedemption[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  @@index([requesterId])
  @@index([employeeId])
  @@index([typeId])
  @@index([assigneeId])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([employeeId, status, createdAt])
  @@index([typeId, status, createdAt])
  @@index([assignedArea, status, createdAt])
  @@index([priority])
  @@index([assignedArea])
}

model MonthlyAdvanceRecord {
  id             String          @id @default(cuid())
  employeeId     String
  referenceMonth String
  optIn          Boolean
  amount         Decimal         @db.Decimal(10, 2)
  hasDiscount    Boolean         @default(false)
  discountAmount Decimal?        @db.Decimal(10, 2)
  discountReason String?
  finalAmount    Decimal         @db.Decimal(10, 2)
  status         String          @default("ACTIVE")
  observation    String?
  updatedById    String?
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedBy      User?           @relation("MonthlyAdvanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([employeeId, referenceMonth])
  @@index([referenceMonth])
  @@index([referenceMonth, optIn])
  @@index([referenceMonth, status])
  @@index([employeeId])
  @@index([optIn])
  @@index([updatedById])
}

model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  message   String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model RequestHistory {
  id        String         @id @default(cuid())
  requestId String
  actorId   String
  action    String?
  from      RequestStatus?
  to        RequestStatus
  reason    String?
  metadata  Json?
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User           @relation(fields: [actorId], references: [id])
  createdAt DateTime       @default(now())
}

model ApprovalFlow {
  id            String         @id @default(cuid())
  requestId     String?
  requestTypeId String?
  name          String
  isActive      Boolean        @default(true)
  request       Request?       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestType   RequestType?   @relation(fields: [requestTypeId], references: [id])
  steps         ApprovalStep[]
}

model ApprovalStep {
  id            String        @id @default(cuid())
  flowId        String
  approverId    String?
  roleName      String
  stepOrder     Int
  status        RequestStatus @default(AGUARDANDO_APROVACAO)
  decidedAt     DateTime?
  justification String?
  flow          ApprovalFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  approver      User?         @relation(fields: [approverId], references: [id])
}

model Announcement {
  id             String             @id @default(cuid())
  title          String
  content        String
  category       String
  targetAudience String
  authorId       String
  status         AnnouncementStatus @default(PUBLICADO)
  isPinned       Boolean            @default(false)
  requiresRead   Boolean            @default(false)
  publishAt      DateTime           @default(now())
  author         User               @relation(fields: [authorId], references: [id])
  reads          AnnouncementRead[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  category  String
  type      String    @default("INFO")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  entity    String?
  entityId  String?
  href      String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([userId, isRead, createdAt])
  @@index([entity, entityId])
}

model PerformanceMetric {
  id           String          @id @default(cuid())
  employeeId   String
  period       DateTime
  productivity Float
  quality      Float
  presence     Float
  adherence    Float
  tokensEarned Int             @default(0)
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
}

model QualityFeedback {
  id             String                 @id @default(cuid())
  employeeId     String
  authorId       String
  type           String
  theme          String
  message        String
  classification FeedbackClassification
  evidenceUrl    String?
  readAt         DateTime?
  employee       EmployeeProfile        @relation("FeedbackEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  author         User                   @relation("FeedbackAuthor", fields: [authorId], references: [id])
  createdAt      DateTime               @default(now())
}

model QualityMaterial {
  id          String   @id @default(cuid())
  title       String
  description String
  url         String
  category    String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
}

model ClimateSurvey {
  id          String            @id @default(cuid())
  title       String
  description String
  status      String            @default("Ativa")
  anonymous   Boolean           @default(true)
  targetType  String            @default("TODOS")
  targetValue String?
  createdById String?
  startsAt    DateTime
  endsAt      DateTime
  questions   ClimateQuestion[]
  answers     ClimateAnswer[]
  responses   ClimateSurveyResponse[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([targetType, targetValue])
}

model ClimateQuestion {
  id       String              @id @default(cuid())
  surveyId String
  text     String
  type     ClimateQuestionType
  options  Json?
  required Boolean             @default(true)
  order    Int
  survey   ClimateSurvey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers  ClimateAnswer[]
}

model ClimateAnswer {
  id           String          @id @default(cuid())
  surveyId     String
  questionId   String
  responseId   String?
  respondentId String?
  value        Json
  survey       ClimateSurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question     ClimateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response     ClimateSurveyResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  respondent   User?           @relation(fields: [respondentId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([surveyId, respondentId])
  @@index([responseId])
}

model ClimateSurveyResponse {
  id               String          @id @default(cuid())
  surveyId         String
  respondentUserId String?
  employeeId       String?
  submittedAt      DateTime        @default(now())
  metadata         Json?
  survey           ClimateSurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers          ClimateAnswer[]

  @@unique([surveyId, respondentUserId])
  @@index([surveyId])
  @@index([respondentUserId])
  @@index([employeeId])
}

model AnonymousFeedback {
  id          String                  @id @default(cuid())
  category    String
  message     String
  evidenceUrl String?
  status      AnonymousFeedbackStatus @default(RECEBIDO)
  urgency     String                  @default("MEDIA")
  allowContact Boolean                @default(false)
  contactUserId String?
  lobId       String?
  jobTitle    String?
  resolvedAt  DateTime?
  resolvedById String?
  theme       String?
  actionPlan  ActionPlan?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([category])
  @@index([urgency])
  @@index([lobId])
}

model ActionPlan {
  id                  String             @id @default(cuid())
  title               String
  description         String
  ownerArea           String
  status              String             @default("Em andamento")
  dueDate             DateTime?
  anonymousFeedbackId String?            @unique
  anonymousFeedback   AnonymousFeedback? @relation(fields: [anonymousFeedbackId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
}

model Equipment {
  id          String             @id @default(cuid())
  code        String             @unique
  type        String
  model       String?
  serial      String?
  employeeId  String?
  status      EquipmentStatus
  deliveredAt DateTime?
  impact      EquipmentImpact    @default(BAIXO)
  employee    EmployeeProfile?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  histories   EquipmentHistory[]
  tickets     EquipmentTicket[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([employeeId])
  @@index([status])
  @@index([deletedAt])
  @@index([status, updatedAt])
  @@index([deliveredAt])
}

model EquipmentHistory {
  id          String    @id @default(cuid())
  equipmentId String
  actorId     String
  action      String
  before      Json?
  after       Json?
  reason      String?
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [id])
  createdAt   DateTime  @default(now())
}

model EquipmentTicket {
  id          String           @id @default(cuid())
  code        String           @unique
  equipmentId String
  employeeId  String?
  openedById  String
  title       String
  description String
  impact      EquipmentImpact  @default(MEDIO)
  status      TicketStatus     @default(ABERTO)
  slaDueAt    DateTime
  equipment   Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  employee    EmployeeProfile? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  openedBy    User             @relation(fields: [openedById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model StaffCoverage {
  id              String       @id @default(cuid())
  date            DateTime
  lobId           String
  shiftId         String
  plannedStaff    Int
  requiredStaff   Int
  coveragePercent Float
  gap             Int
  risk            CoverageRisk
  observation     String?
  createdById     String?
  updatedById     String?
  lob             Lob          @relation(fields: [lobId], references: [id], onDelete: Cascade)
  shift           Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("StaffCoverageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?        @relation("StaffCoverageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([date, lobId, shiftId])
  @@index([date])
  @@index([lobId])
  @@index([shiftId])
  @@index([date, lobId])
  @@index([date, shiftId])
  @@index([date, lobId, shiftId])
  @@index([createdById])
  @@index([updatedById])
}

model TokenBalance {
